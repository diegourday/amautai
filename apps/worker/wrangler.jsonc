{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amautai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/callback"
    ]
  },
  "account_id": "49d9cc4a3f40d7228ed3593263d35588",
  "routes": [
    {
      "pattern": "amautai.turistivo.com",
      "custom_domain": true
    },
    {
      "pattern": "amautai.turistivo.com/*",
      "zone_name": "turistivo.com"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "AUTH_EMAIL_MODE": "custom",
    "WORKOS_CLIENT_ID": "client_01M55794X1B33VNMX8PW0JEYQ9",
    "WORKOS_TOKEN_ISSUER": "https://api.workos.com/user_management/client_01M55794X1B33VNMX8PW0JEYQ9",
    "APP_ORIGINS": "http://localhost:5173,https://amautai.turistivo.com",
    "WHATSAPP_GATEWAY_URL": "https://wts.urday.dev",
    "ROOM_PRESET_MEMORY_ENABLED": "true",
    "ATOMICMEMORY_API_URL": "https://api.atomicstrata.ai"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "andes-app-db",
      "database_id": "11764a92-4ee9-4d46-bbe1-3cd0d6c8af97",
      "migrations_dir": "migrations"
    }
  ]
}
